#Encryption program
def encrypt(message, shift):
    encrypted = []
    for char in message:
        if char.isalpha():
            base = ord('A') if char.isupper() else ord('a')
            shifted = (ord(char) - base + shift) % 26
            number = shifted
            cubed = number ** 3
            encrypted.append(str(cubed))
        else:
            encrypted.append(char)
    print(" ".join(encrypted) ) 
    done=input("Is that all? ").lower()
    if done == "yes":
        go_back = input("Do you want to go back or exit ").lower()
        if go_back == "back":
            PassProof()
        elif go_back == "exit":
            print("Enjoy your Hash! ")
        else:
            print("Invalid, try typing \"back\" or \"end\" ")
            go_back
    elif done == "no":
        retry = input("Do you want to create another Hash? ").lower()
        if retry == "yes":
            new_message = input("what are you encrypting ").lower()
            new_shift = int(input("how far are you shifting the values "))
            encrypt(new_message, new_shift)
        elif retry == "no":
            PassProof()
        else:
            print("Invalid Value")
    else:
        print("Invalid Value")
        
    
